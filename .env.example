# ─── Gmail / IMAP credentials (read on the server only) ───────────────────────
# The Gmail address whose inbox is read over IMAP. Also shown to the user in the
# on-screen login instructions.
EMAIL=you@gmail.com

# A Gmail **App Password** (16 chars), NOT your normal account password.
# Create one at https://myaccount.google.com/apppasswords (requires 2FA).
EMAIL_PASSWORD=your_gmail_app_password

# IMAP host. For Gmail this is imap.gmail.com.
IMAP=imap.gmail.com

# ─── Access control (invite links) ────────────────────────────────────────────
# Read connection string of the Vercel Edge Config that holds `tokens`
# (token → { name, createdAt, ... }). Without it every page is locked.
EDGE_CONFIG=https://edge-config.vercel.com/ecfg_xxx?token=yyy
# Needed to *write* (create / revoke invites from /admin):
EDGE_CONFIG_ID=ecfg_xxx
VERCEL_API_TOKEN=your_vercel_account_token   # vercel.com/account/settings/tokens
VERCEL_TEAM_ID=team_xxx                      # if the Edge Config lives in a team
# Password for /admin (any long random string).
ADMIN_TOKEN=change-me

# ─── Visitor notifications via Telegram (optional) ────────────────────────────
# When both are set, every visit to /claude or /blancvpn by an invited person
# sends you a Telegram message with their name, IP and city.
# Bot token: create a bot with @BotFather (/newbot).
# Chat id: your numeric id — write anything to @userinfobot, or open
# https://api.telegram.org/bot<TOKEN>/getUpdates after messaging your bot.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=123456789

# ─── Optional overrides ───────────────────────────────────────────────────────
# IMAP_PORT=993
# IMAP_MAILBOX=INBOX
# MAIL_LOOKBACK_DAYS=30
# LOGIN_EMAIL=you@gmail.com   # defaults to EMAIL if unset
